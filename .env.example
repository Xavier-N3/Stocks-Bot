# =====================================================================
#  AI TRADING FIRM - settings. Only the 3 Alpaca lines are required.
# =====================================================================

# ---- Alpaca (free): https://alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# true = fake money (stay here until months of results prove it works)
ALPACA_PAPER=true
# Real money needs BOTH ALPACA_PAPER=false AND this set to true.
I_UNDERSTAND_LIVE_TRADING_RISK=false

# ---- Free AI keys (add as many as you like; more = more free capacity) ----
# Groq   - https://console.groq.com/keys          (no card)  <- most important
GROQ_API_KEY=
# Google - https://aistudio.google.com/apikey     (no card)
GEMINI_API_KEY=
# Mistral- https://console.mistral.ai/api-keys    (free "Experiment" plan, phone verify)
MISTRAL_API_KEY=
# OpenRouter - https://openrouter.ai/keys         (optional, 50 free requests/day)
OPENROUTER_API_KEY=
# Local AI on this PC (unlimited, slower). Already installed if you ran Ollama.
OLLAMA_HOST=http://localhost:11434
LLM_ENABLED=true

# Order the AI models are tried in ("provider:model"). Leave as-is unless a model is retired.
# LLM_CHAIN_SMART=groq:openai/gpt-oss-120b,gemini:gemini-flash-latest,mistral:mistral-medium-latest,groq:qwen/qwen3.8-27b,openrouter:openai/gpt-oss-120b:free,ollama:qwen3.5:4b,ollama:llama3.2:3b
# LLM_CHAIN_FAST=groq:openai/gpt-oss-20b,gemini:gemini-flash-lite-latest,mistral:mistral-small-latest,groq:qwen/qwen3.8-27b,ollama:qwen3.5:4b,ollama:llama3.2:3b

# veto = AI can reject/resize trades | advisory = AI only comments | off = numbers only
LLM_TRADE_MODE=veto

# ---- Capital split between desks (manager adjusts weekly within limits) ----
SLEEVE_DAY=0.20
SLEEVE_SWING=0.35
SLEEVE_LONG=0.45
MAX_POSITIONS_DAY=5
MAX_POSITIONS_SWING=8
MAX_POSITIONS_LONG=12
# Under $25k equity (pattern-day-trader rule) the desks automatically use these instead:
SMALL_MAX_POSITIONS_DAY=2
SMALL_MAX_POSITIONS_SWING=5
SMALL_MAX_POSITIONS_LONG=6

# ---- How hard to press: conservative | balanced | aggressive ----
# aggressive = ~2x the risk per trade, bigger positions, 6% account daily-loss stop.
# All sizes are a % of current equity, so profits compound automatically as the account grows.
RISK_PROFILE=balanced
# Optional overrides of the profile:
# ACCOUNT_DAILY_LOSS_PCT=0.06
# PROBATION_SIZE=0.75
# While no brain has proven an edge on unseen data, trade smaller (or set false to sit out).
PROBATION_TRADING=true

# ---- Stocks ----
# Never trade these (comma separated)
EXCLUDE_SYMBOLS=
# Add stocks beyond the S&P 500 + major ETFs
EXTRA_SYMBOLS=

# Reports (New York time)
REPORT_TIMES_ET=00:30,08:30,16:30
# SEC asks for a contact in the User-Agent; put your email here if SEC data stops loading.
SEC_USER_AGENT=StocksBot personal-research contact@example.com

# ---- The Studio (web view) ----
STUDIO_PORT=8765
# 127.0.0.1 = only this machine. Use 0.0.0.0 only on a cloud server behind Tailscale or a firewall.
STUDIO_HOST=127.0.0.1
# Set a password whenever the Studio can be reached from the internet (e.g. through a Cloudflare Tunnel).
STUDIO_PASSWORD=
