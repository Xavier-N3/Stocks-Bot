+.brand b { display: block; font-size: 17px; letter-spacing: .2px; }
+.brand small { color: var(--text-muted); font-size: 12px; }
+.tabs { display: flex; gap: 4px; background: var(--surface-1); padding: 4px; border-radius: 12px; border: 1px solid var(--line); }
