+                                               pool=self._pool_for(name, ds) if boost else None,
+                                               n_cands=config.BOOST_CANDIDATES if boost else 6)
+        except Exception:
+            if boost:
+                self._close_pool(name)     # a broken worker pool gets rebuilt next run
